# ExamCraft AI — Environment Configuration

# Server Settings
PORT=8080
NODE_ENV=development

# Security & JWT Tokens
JWT_SECRET=examcraft-super-secret-production-key-change-this-in-prod-2026
JWT_EXPIRES_IN=7d

# Database Connection (PostgreSQL is primary)
# If PostgreSQL credentials are provided, ExamCraft AI connects to PostgreSQL automatically.
# Format: postgres://username:password@localhost:5432/examcraft_ai
DATABASE_URL=postgres://postgres:postgres@localhost:5432/examcraft_ai
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=examcraft_ai

# Real AI Provider Configuration (Google Gemini is preferred)
# Supported model: gemini-3.8-flash, gemini-1.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Alternative AI Provider (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Document Storage Path
UPLOAD_DIR=./server/storage/uploads
MAX_FILE_SIZE_MB=25
